+        F: Fn(&Url) -> Result<(), E> + Send + Sync + 'static,
+        E: Into<Box<dyn std::error::Error + Send + Sync>>,
+    {
+        self.config.request_validator = Some(Arc::new(move |url| validate(url).map_err(Into::into)));
+        self
+    }

# Maintainer: Jason Alexander <jason@greatspark.com>
# Builds the native Rust app and engine from this checkout: cd packaging && makepkg
pkgname=pipkin
pkgver=1.1.0
pkgrel=1
pkgdesc='Native Wayland desktop coding agent with the built-in Rust engine'
arch=('x86_64')
url='https://github.com/last-refuge/pipkin'
license=('MIT')
depends=('wayland' 'libxkbcommon' 'libxkbcommon-x11' 'libxcb' 'vulkan-icd-loader' 'fontconfig' 'git')
makedepends=('rust' 'cargo' 'zstd' 'clang' 'cmake' 'python' 'binutils')
optdepends=('foot: terminal for the "open terminal" action'
            'orca: screen reader'
            'fcitx5: input methods')
# Keep Cargo release line tables; full-DWARF overrides triple the payload.
options=('!strip' '!lto' '!debug')
[[ ${PIPKIN_ENGINE:-native} == native ]] || { echo 'Pi packaging is retired; use the native engine.' >&2; return 1; }

build() {
  cd "$startdir/.."
  PIPKIN_NATIVE_OUT="$srcdir/native" scripts/package-native.sh
}

package() {
  cp -a "$srcdir/native/stage/." "$pkgdir/"
}
